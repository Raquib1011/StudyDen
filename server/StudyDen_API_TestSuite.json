{
  "info": {
    "name": "StudyDen API Automated Test Suite",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Server Health Check",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:9120/api/health",
          "protocol": "http",
          "host": ["localhost"],
          "port": "9120",
          "path": ["api", "health"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
              "pm.test('Response contains server running message', function () { var jsonData = pm.response.json(); pm.expect(jsonData.ok).to.eql(true); });",
              "pm.test('Response time under 500ms', function () { pm.expect(pm.response.responseTime).to.be.below(500); });"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Public Home Stats Verification",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:9120/api/home/stats",
          "protocol": "http",
          "host": ["localhost"],
          "port": "9120",
          "path": ["api", "home", "stats"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
              "pm.test('Response is JSON format', function () { pm.response.to.be.json; });"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Get Public Spots List",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:9120/api/spots",
          "protocol": "http",
          "host": ["localhost"],
          "port": "9120",
          "path": ["api", "spots"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
              "pm.test('Spots list returned', function () { pm.expect(pm.response.json()).to.exist; });"
            ]
          }
        }
      ]
    }
  ]
}